package postgres

import (
	"database/sql"
	"fmt"

	"github.com/jmoiron/sqlx"
	"github.com/google/uuid"
	"golang.org/x/net/context"

  "github.com/grid-x/ds-api/pkg/model"
)

{{ $repo := printf "%s%s" (title .Plural) "Repository" -}}
{{- $ident := untitle .Plural -}}
{{- $entity := printf "model.%s" (title .Singular) -}}
{{- $table := tolower $ident }}

// SQL statements to manage {{ .Plural }}
const (
	{{ $ident }}SelectBase = `
	SELECT
		{{- $c := counter -}}
		{{- range $index, $attribute := .Attributes }}{{ if call $c }},{{end}}
		{{ dbColumn .Name }}
		{{- end }}
	FROM {{ $table }}
	`

	// {{ $ident }}NotDeletedFilter filters out all deleted items.
	{{ $ident }}NotDeletedFilter = `(deleted_at IS NULL OR deleted_at > now())`

	// {{ $ident }}PaginationFilter filters
	{{ $ident }}PaginationFilter = `OFFSET $1 LIMIT $2`

	{{ $ident }}Select = {{ $ident }}SelectBase +
		` WHERE ` + {{ $ident }}NotDeletedFilter + ` ORDER BY $sort $direction ` + {{ $ident }}PaginationFilter

	{{ $ident }}SelectByID = {{ $ident }}SelectBase +
		` WHERE uuid = $1 AND ` + {{ $ident }}NotDeletedFilter

	{{ $ident }}Insert = `
	INSERT INTO {{ $table }}
	(
		{{- $c := counter -}}
		{{- range $index, $attribute := .Attributes }}{{ if call $c }},{{end}}
		{{ dbColumn .Name }}
		{{- end }}
	)
	VALUES (
		{{- $c := counter -}}
		{{- range $index, $attribute := .Attributes }}{{ if call $c }},{{end}}
		{{ printf ":%s" (dbColumn .Name) }}
		{{- end }}
	)
	`

	{{ $ident }}Update = `
	UPDATE {{ $table }}
	SET
		updated_at = DEFAULT
	WHERE uuid = :uuid
	`

	{{ $ident }}SoftDelete = `
	UPDATE {{ $table }}
	SET
		updated_at = DEFAULT,
		deleted_at = now()
	WHERE uuid = $1
	`

	{{ $ident }}HardDelete = `
	DELETE FROM {{ $table }}
	WHERE uuid = $1
	`
)

var (
	// {{ $ident }}SortableColumns defines the columns which are sortable.
	// The first value is used as the default.
	{{ $ident }}SortableColumns = []string{"created_at", "updated_at", "name"}
)

// {{ $repo }} manages the access to the underlying postgres database.
type {{ $repo }} struct {
	lists   map[string]*sqlx.Stmt
	getByID *sqlx.Stmt

	create *sqlx.NamedStmt
	update *sqlx.NamedStmt

	softDelete *sqlx.Stmt
	hardDelete *sqlx.Stmt
}


// New{{ $repo }} creates a {{ $repo }} for accessing the
// related tables.
func New{{ $repo }}(db *sqlx.DB) (*{{ $repo }}, error) {
	ctx := context.Background()

	lists := make(map[string]*sqlx.Stmt)
	for _, s := range {{ $ident }}SortableColumns {
		for _, d := range model.AllOrders {
			var err error
			key, query := prepareOrderQuery({{ $ident }}Select, s, d)
			lists[key], err = db.PreparexContext(ctx, query)
			if err != nil {
				return nil, err
			}
		}
	}

	getByID, err := db.PreparexContext(ctx, {{ $ident }}SelectByID)
	if err != nil {
		return nil, err
	}

	create, err := db.PrepareNamedContext(ctx, {{ $ident }}Insert)
	if err != nil {
		return nil, err
	}
	update, err := db.PrepareNamedContext(ctx, {{ $ident }}Update)
	if err != nil {
		return nil, err
	}

	softDelete, err := db.PreparexContext(ctx, {{ $ident }}SoftDelete)
	if err != nil {
		return nil, err
	}
	hardDelete, err := db.PreparexContext(ctx, {{ $ident }}HardDelete)
	if err != nil {
		return nil, err
	}

	return &{{$repo}}{
		lists:      lists,
		getByID:    getByID,
		create:     create,
		update:     update,
		softDelete: softDelete,
		hardDelete: hardDelete,
	}, nil
}

// Close closes all prepared statements.
func (r *{{ $repo }}) Close() error {
	var final error
	for _, list := range r.lists {
		if err := list.Close(); err != nil {
			final = err
		}
	}
	if err := r.getByID.Close(); err != nil {
		final = err
	}
	if err := r.create.Close(); err != nil {
		final = err
	}
	if err := r.update.Close(); err != nil {
		final = err
	}
	if err := r.softDelete.Close(); err != nil {
		final = err
	}
	if err := r.hardDelete.Close(); err != nil {
		final = err
	}
	return final
}


// List returns a set of {{ $ident }}
func (r *{{ $repo }}) List(ctx context.Context, opts *model.SortedListOptions) ([]*{{ $entity }}, bool, error) {
	opts = opts.Sanitize({{ $ident }}SortableColumns[0], {{ $ident }}SortableColumns)
	entities := []*{{ $entity }}{}
	hasNext := false

	q, ok := r.lists[fmt.Sprintf("%s:%s", opts.Sort, opts.Order)]
	if !ok {
		return nil, false, fmt.Errorf("couldn't find appropriate query")
	}
	err := q.SelectContext(ctx, &entities, (opts.Page-1)*opts.PerPage, opts.PerPage+1)

	// Check if we will have another page of results
	if len(entities) > opts.PerPage {
		entities = entities[:opts.PerPage]
		hasNext = true
	}

	return entities, hasNext, err
}

// GetByID fetches a {{ $ident }} by its id.
func (r *{{ $repo }}) GetByID(ctx context.Context, id string) (*{{ $entity }}, error) {
	if id == "" {
		return nil, fmt.Errorf("no {{ $entity }} uuid provided")
	}
	var entity {{ $entity }}
	err := r.getByID.GetContext(ctx, &entity, id)
	if err != nil {
		return nil, err
	}
	return &entity, nil
}

// Create creates a new {{ $ident }}
func (r *{{ $repo }}) Create(ctx context.Context, e *{{ $entity }}) (*{{ $entity }}, error) {

	if e == nil {
		return nil, fmt.Errorf("couldn't create nil object")
	}
        // TODO: add validation

	// New ID for the {{ $ident }}
	e.UUID = uuid.New().String()
	_, err := NamedStmt(ctx, r.create).ExecContext(ctx, e)
	if err != nil {
		return nil, err
	}
	return e, nil
}

// Update updates the {{ $ident }}
func (r *{{ $repo }}) Update(ctx context.Context, e *{{ $entity }}) (*{{ $entity }}, error) {
	if e == nil {
		return nil, fmt.Errorf("couldn't create nil object")
	}
	if e.UUID == "" {
		return nil, fmt.Errorf("{{ $ident }} uuid is missing")
	}
	_, err := NamedStmt(ctx, r.update).ExecContext(ctx, e)
	if err != nil {
		return nil, err
	}
	return e, nil
}

// Delete marks a {{ $ident }} as deleted. If hard is set, it deletes the actual table row.
func (r *{{ $repo }}) Delete(ctx context.Context, id string, hard bool) error {
	if id == "" {
		return fmt.Errorf("{{ $ident }} id is missing")
	}
	if hard {
		result, err := Stmt(ctx, r.hardDelete).ExecContext(ctx, id)
		if count, _ := result.RowsAffected(); count == 0 {
			return sql.ErrNoRows
		}
		return err
	}
	result, err := Stmt(ctx, r.softDelete).ExecContext(ctx, id)
	if count, _ := result.RowsAffected(); count == 0 {
		return sql.ErrNoRows
	}
	return err
}
