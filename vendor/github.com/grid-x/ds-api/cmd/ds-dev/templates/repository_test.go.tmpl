func Test{{ title $ident }}Delete(t *testing.T) {

	_, repo := create{{ title $ident }}(0, t)
	defer repo.Close()

	testCases := []struct {
		name string
		hard bool
	}{
		{
			name: "accept-soft-delete",
			hard: false,
		},
		{
			name: "accept-hard-delete",
			hard: true,
		},
	}

	wantItems, _, err := repo.List(context.Background(), nil)
	if err != nil {
		t.Fatal(err)
	}

	for _, tc := range testCases {
		t.Run(tc.name, func(t *testing.T) {
			InitTest()
			ctx := context.Background()
			item, err := repo.Create(ctx, &{{ $entity }}{
		  // TODO: add fields
			})
			if err != nil {
				t.Fatal(err)
			}

			if err := repo.Delete(ctx, item.UUID, tc.hard); err != nil {
				t.Error(err)
			}

			_, err = repo.GetByID(ctx, item.UUID)
			if err != sql.ErrNoRows {
				t.Error(err)
			}

			items, _, err := repo.List(ctx, nil)
			if err != nil {
				t.Fatal(err)
			}

			if len(items) != len(wantItems) {
				t.Errorf("Delete = %d, want %d", len(items), len(wantItems))
			}
		})
	}

}

func Test{{ title $ident }}Pagination(t *testing.T) {
	_, repo := create{{ title $ident}}(model.PerPageMax+1, t)
	defer repo.Close()

	testCases := []struct {
		name        string
		opts        *model.SortedListOptions
		resultCount int
		hasNext     bool
	}{
		{
			name:        "No list options",
			opts:        nil,
			resultCount: model.PerPageDefault,
			hasNext:     true,
		},
		{
			name: "PerPage underflow",
			opts: &model.SortedListOptions{
				ListOptions: &model.ListOptions{Page: 0, PerPage: -20},
			},
			resultCount: model.PerPageMin,
			hasNext:     true,
		},
		{
			name: "PerPage right",
			opts: &model.SortedListOptions{
				ListOptions: &model.ListOptions{Page: 0, PerPage: 10},
			},
			resultCount: 10,
			hasNext:     true,
		},
		{
			name: "PerPage overflow",
			opts: &model.SortedListOptions{
				ListOptions: &model.ListOptions{Page: 0, PerPage: 1337},
			},
			resultCount: model.PerPageMax,
			hasNext:     true,
		},
		{
			name: "Page underflow",
			opts: &model.SortedListOptions{
				ListOptions: &model.ListOptions{Page: -10, PerPage: -20},
			},
			resultCount: model.PerPageMin,
			hasNext:     true,
		},
		{
			name: "Page right",
			opts: &model.SortedListOptions{
				ListOptions: &model.ListOptions{Page: 2, PerPage: 20},
			},
			resultCount: 20,
			hasNext:     true,
		},
		{
			name: "Page overflow",
			opts: &model.SortedListOptions{
				ListOptions: &model.ListOptions{Page: 100, PerPage: 20},
			},
			resultCount: 0,
			hasNext:     false,
		},
	}

	for _, tc := range testCases {
		t.Run(tc.name, func(t *testing.T) {
			InitTest()
			items, hasNext, err := repo.List(context.Background(), tc.opts)

			if err != nil {
				t.Fatal("Failed to list {{ tolower $ident }}")
			}

			if len(items) != tc.resultCount {
				t.Fatalf("%s: len(items) = %d, expected %d", tc.name, len(items), tc.resultCount)
			}
			if hasNext != tc.hasNext {
				t.Fatalf("%s: hasNext = %v, expected %v", tc.name, hasNext, tc.hasNext)
			}
		})
	}
}

// create{{ title $ident }} creates {{ $ident }}. It returns the list of created
// {{ $ident }} and the {{ $repository }}
func create{{ title $ident }}(count int, t *testing.T) ([]*{{ $entity }},*postgres.{{ $repository }}) {
	list := make([]*{{ $entity }}, count)
	repo, err := postgres.New{{ $repository }}(DB)
	if err != nil {
		t.Fatal(err)
	}

	for i := 0; i < count; i++ {
		item, err := repo.Create(context.Background(), &{{ $entity }}{
		// TODO: add fields
		})

		if err != nil {
			t.Fatalf("could not create {{ tolower .Singular }}: %+v", err)
		}

		list[i] = item
	}

	return list, repo
}
