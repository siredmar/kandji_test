{{ $repository := printf "%s%s" (title .Plural) "Repository" -}}
{{- $ident :=  .Plural -}}
{{- $entity := printf "model.%s" (title .Singular) -}}

func Test{{ title $ident }}List(t *testing.T) {

	list, repo := create{{ title $ident }}(10, t)
  // TODO: use list and remove the line below
  var _ = list
	defer repo.Close()

	testCases := []struct {
		name string
		opts *model.SortedListOptions
		want []*{{ $entity }}
	}{
		{
			name: "accept-without-list-options",
			want: []*{{ $entity }}{},
		},
		{
			name: "accept-per-page",
			opts: &model.SortedListOptions{
				ListOptions: &model.ListOptions{
					Page:    2,
					PerPage: 2,
				},
			},
			want: []*{{ $entity }}{},
		},
		{
			name: "accept-desc-direction",
			opts: &model.SortedListOptions{
				Order: "desc",
				ListOptions: &model.ListOptions{
					Page:    1,
					PerPage: 3,
				},
			},
			want: []*{{ $entity }}{},
		},
		{
			name: "accept-asc-direction",
			opts: &model.SortedListOptions{
				Order: "asc",
				ListOptions: &model.ListOptions{
					Page:    1,
					PerPage: 3,
				},
			},
			want: []*{{ $entity }}{},
		},
		{
			name: "fallback-to-asc-direction",
			opts: &model.SortedListOptions{
				Order: "abc",
				ListOptions: &model.ListOptions{
					Page:    1,
					PerPage: 3,
				},
			},
			want: []*{{ $entity }}{},
		},
	}

	for _, tc := range testCases {
		t.Run(tc.name, func(t *testing.T) {
			InitTest()
			ctx := context.Background()
			items, _, err := repo.List(ctx, tc.opts)
			if err != nil {
				t.Fatal(err)
			}

			if len(items) != len(tc.want) {
				t.Errorf("{{ tolower $ident }} list length = %d, want %d", len(items), len(tc.want))
			}

			if !cmp.Equal(tc.want, items) {
				t.Errorf("{{ tolower $ident }} list = %+v, want %+v", items, tc.want)
			}
		})
	}
}

func Test{{ title $ident }}Create(t *testing.T) {
	repo, err := postgres.New{{ $repository }}(DB)
	if err != nil {
		t.Fatal(err)
	}
	defer repo.Close()

	testCases := []struct {
		name    string
		input    *{{ $entity }}
		wantErr bool
	}{
		{
			name:    "reject-without",
			wantErr: true,
		},
	}

	for _, tc := range testCases {
		t.Run(tc.name, func(t *testing.T) {
		InitTest()
			ctx := context.Background()

			want, err := repo.Create(ctx, tc.input)
			if err != nil && !tc.wantErr {
				t.Fatal(err)
			} else if err == nil && tc.wantErr {
				t.Fatal("create expect error to be returned")
			} else if tc.wantErr {
				return
			}

			got, err := repo.GetByID(ctx, want.UUID)
			if err != nil {
				t.Fatal(err)
			}

			opts := cmpopts.IgnoreFields({{ $entity }}{},
				"CreatedAt", "UpdatedAt",
			)
			if !cmp.Equal(got, want, opts) {
				t.Errorf("create = %+v, want %+v", got, want)
			}
		})
	}
}

